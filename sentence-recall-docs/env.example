# Project-root .env.local. Restart the dev server after editing.
# Never expose OPENAI_API_KEY or put it in a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=replace_me_with_your_key
OPENAI_MODEL=gpt-4.1-mini

# Optional: connect your Supabase project after running supabase/schema.sql.
# The anon/publishable key is designed for the browser; NEVER use service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exact public origin, e.g. https://learn.example.com (no trailing path).
# Set for a public deployment; use your actual local origin while developing.
APP_ORIGIN=

# Optional local-development preview only. Does NOT grant production entitlement.
ENABLE_MNEMONIC_PREVIEW=true
